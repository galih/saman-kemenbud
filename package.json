{
  "name": "saman-kemenbud",
  "version": "1.0.0",
  "description": "Aplikasi desktop Windows 11 untuk https://saman.kemenbud.go.id",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist-win": "electron-builder --win nsis portable"
  },
  "build": {
    "appId": "id.go.kemenbud.saman.desktop",
    "productName": "SAMAN Kemenbud",
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SAMAN Kemenbud"
    }
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12"
  }
}
